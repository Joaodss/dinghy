# Secrets for dinghy. Copy to dinghy.env and keep it out of git.
# Values are taken literally (no quotes, no $ expansion).

# printf '%s' 'your password' | docker run --rm -i ghcr.io/joaodss/dinghy:0.1.0 hash-password
DINGHY_PASSWORD_HASH=

# Cloudflare Access: team name (or full team domain), application AUD tag,
# and the emails allowed in (comma-separated).
DINGHY_CF_TEAM=
DINGHY_CF_AUD=
DINGHY_ALLOWED_EMAILS=

# Keeps sessions valid across restarts: openssl rand -hex 32
DINGHY_SESSION_SECRET=
